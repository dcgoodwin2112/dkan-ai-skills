#!/usr/bin/env bash
# Test the plugin's PreToolUse hooks: dependency-gate decisions and commit-gate
# detection + scoping. Prints "PASS" / "FAIL" per case and exits non-zero on any
# failure. Requires jq (and git for the commit-gate cases); skips cleanly without.

set -uo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

fails=0
tmp_dirs=()

cleanup() {
  for d in ${tmp_dirs[@]+"${tmp_dirs[@]}"}; do
    [[ -d "$d" ]] && rm -rf "$d"
  done
}
trap cleanup EXIT

fresh_tmp() {
  local d
  d="$(mktemp -d)"
  tmp_dirs+=("$d")
  echo "$d"
}

assert() {
  local label="$1" cond="$2"
  if eval "$cond"; then
    echo "  PASS  $label"
  else
    echo "  FAIL  $label  [$cond]"
    fails=$((fails + 1))
  fi
}

echo "Test 1: dependency-gate hook decisions"
hook="$repo_root/plugins/drupal-dkan-ai/hooks/dependency-gate.sh"
if ! command -v jq >/dev/null 2>&1; then
  echo "  SKIP  jq not installed"
else
  gate_verdict()     { jq -Rn --arg c "$1" '{tool_input:{command:$c}}' | CLAUDE_GATE_DRYRUN=1 bash "$hook" 2>&1; }
  gate_exit()        { jq -Rn --arg c "$1" '{tool_input:{command:$c}}' | { bash "$hook" >/dev/null 2>&1; echo $?; }; }
  gate_exit_bypass() { jq -Rn --arg c "$1" '{tool_input:{command:$c}}' | { CLAUDE_SKIP_DEP_GATE=1 bash "$hook" >/dev/null 2>&1; echo $?; }; }

  # Package-adding commands must be gated (incl. wrapper, quoted, nested-shell,
  # and `python -m pip` forms).
  for c in \
    'composer require drupal/foo' 'npm install left-pad' 'ddev composer require x/y' \
    'yarn add vue' 'pip install requests' 'python -m pip install requests' \
    'python3 -m pip install flask' '"npm" install evil' 'bash -c "npm install evil"' \
    'uv add ruff' 'uv pip install requests' 'uv tool install black' \
    'poetry add flask' 'pipx install black' 'deno add npm:left-pad' \
    'composer global require x/y' 'yarn global add vue' \
    'ddev exec -s web composer require drupal/foo' \
    'docker compose exec app composer require x/y' \
    'composer req drupal/foo' 'composer global req x/y' \
    'docker exec -u root app npm add left-pad'; do
    assert "blocks: $c" "gate_verdict '$c' | grep -q 'WOULD GATE'"
  done
  # Lockfile-driven / non-install commands must pass.
  for c in \
    'composer install' 'npm install' 'npm install --prefix frontend' \
    'pip install -r requirements.txt' 'go install ./...' 'git commit -m "npm install foo"' \
    'uv pip install -r requirements.txt' 'uv sync' 'poetry install' \
    'pipx run black' 'deno install' 'deno task build' \
    'npx create-react-app myapp' 'pnpm dlx cowsay hi' 'uvx ruff check' \
    'ddev drush ev "composer require x/y"' 'grep "composer require" README.md' \
    'ddev exec -s web composer install' 'docker compose logs app'; do
    assert "allows: $c" "gate_verdict '$c' | grep -q 'would allow'"
  done
  assert "block returns exit 2"  "[[ \"\$(gate_exit 'composer require x/y')\" == 2 ]]"
  assert "allow returns exit 0"  "[[ \"\$(gate_exit 'composer install')\" == 0 ]]"
  assert "bypass returns exit 0" "[[ \"\$(gate_exit_bypass 'composer require x/y')\" == 0 ]]"
  # global subcommands must name the real package, not the literal "global".
  assert "composer global require names the package" "gate_verdict 'composer global require x/y' | grep -q 'composer x/y'"
  assert "yarn global add names the package"         "gate_verdict 'yarn global add vue' | grep -q 'yarn vue'"
  # pip value-taking flags must not be mislabeled as the package.
  assert "pip --target does not mislabel package" "gate_verdict 'pip install --target ./vendor requests' | grep -q 'pip requests'"
  assert "pip -i does not mislabel package"        "gate_verdict 'pip install -i https://example.com/simple requests' | grep -q 'pip requests'"
fi

echo "Test 2: commit-gate detection + scoping"
cg="$repo_root/plugins/drupal-dkan-ai/hooks/commit-gate.sh"
if ! command -v jq >/dev/null 2>&1; then
  echo "  SKIP  jq not installed"
elif ! command -v git >/dev/null 2>&1; then
  echo "  SKIP  git not installed"
else
  cgrepo="$(fresh_tmp)"
  (
    cd "$cgrepo" || exit 1
    git init -q
    git config user.email t@t.t
    git config user.name t
    mkdir -p .ddev modules/custom/foo modules/custom/bar
    printf 'name: x\n' > .ddev/config.yaml
    printf '<?xml/>\n' > modules/custom/foo/phpcs.xml.dist
    printf '<?xml/>\n' > modules/custom/bar/phpcs.xml.dist
    printf '<?php\n' > modules/custom/bar/bar.module
    # Commit bar so it is tracked; its later edit is an UNSTAGED change that only
    # a real `-a`/`--all` should pull into scope.
    git add modules/custom/foo/phpcs.xml.dist modules/custom/bar/phpcs.xml.dist modules/custom/bar/bar.module
    git commit -qm init
    # Actual commit scope: foo.module staged; bar.module modified but NOT staged.
    printf '<?php // staged\n' > modules/custom/foo/foo.module
    git add modules/custom/foo/foo.module
    printf '// unstaged edit\n' >> modules/custom/bar/bar.module
  )
  cg_dry()    { jq -nc --arg c "$1" --arg w "$cgrepo" '{tool_input:{command:$c},cwd:$w}' | CLAUDE_GATE_DRYRUN=1 bash "$cg" 2>&1; }
  cg_bypass() { jq -nc --arg c "$1" --arg w "$cgrepo" '{tool_input:{command:$c},cwd:$w}' | CLAUDE_SKIP_COMMIT_GATE=1 bash "$cg" 2>&1; }
  # Capture-then-match (not `| grep -q`): with pipefail, grep -q's early exit can
  # SIGPIPE the producer and flip the pipeline status on an early-line match.
  assert "gates a real commit"                "[[ \"\$(cg_dry 'git commit -m x')\" == *'would gate'* ]]"
  assert "gate names the touched module"      "[[ \"\$(cg_dry 'git commit -m x')\" == *'modules/custom/foo'* ]]"
  assert "ignores 'git status'"               "[[ \"\$(cg_dry 'git status')\" != *'would gate'* ]]"
  assert "ignores 'git log --grep commit'"    "[[ \"\$(cg_dry 'git log --grep commit')\" != *'would gate'* ]]"
  assert "ignores 'git commit-tree' plumbing" "[[ \"\$(cg_dry 'git commit-tree abc')\" != *'would gate'* ]]"
  assert "bypass env skips the gate"          "[[ \"\$(cg_bypass 'git commit -m x')\" == *bypassed* ]]"
  # -a/--all detection must read the OPTIONS, not the commit message text.
  assert "plain commit does not gate unstaged module"  "[[ \"\$(cg_dry 'git commit -m x')\" != *'modules/custom/bar'* ]]"
  assert "message containing -a does not expand scope" "[[ \"\$(cg_dry 'git commit -m \"document the -a option\"')\" != *'modules/custom/bar'* ]]"
  assert "real -a flag does include unstaged module"   "[[ \"\$(cg_dry 'git commit -am x')\" == *'modules/custom/bar'* ]]"
fi

echo
if [[ $fails -eq 0 ]]; then
  echo "All tests passed."
  exit 0
else
  echo "$fails test(s) failed."
  exit 1
fi
